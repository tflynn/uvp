#
# uv tools
#
export UVP_PROJECTS_DIR="$HOME/tmp/uvp-projects"
export UVP_DEFAULT_PYTHON_VERSION="3.14"
export UVP_VIRTUAL_ENV_DISABLE_PROMPT='true'
export _UVP_VENV_ACTIVE="FALSE"
export UVP_DESCRIPTION_FILE="uvp_description.txt"
export _UVP_VENV_RENAME="TRUE"

# _zg_doc "utils:: uvp_is_installed : Is the 'uv' command installed?"
function uvp_is_installed() {
  if ! command -v uv &> /dev/null; then
    echo "false"
    echo "uv is not installed. Leaving ..." >&2
    return 1
  else
    echo "true"
    return 0
  fi
}

# _zg_doc "utils:: uvp_venv_is_present : Is the uv '.venv' present?"
function uvp_venv_is_present() {
  if [[ -d .venv ]]; then
    echo "true"
    return 0
  else
    echo "false"
    # echo "uv venv not found" >&2
    return 1
  fi
}

# _zg_doc "utils:: uvp_projects_dir_is_present : Is UVP_PROJECTS_DIR present?"
function uvp_projects_dir_is_present() {
  if [[ -d "$UVP_PROJECTS_DIR" ]]; then
    echo "true"
    return 0
  else
    echo "false"
    echo "Environments directory not found: $UVP_PROJECTS_DIR" >&2
    return 1
  fi
}

